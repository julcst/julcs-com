---
---
<main>
    <span class="typed">
        <slot />
    </span>
    <span class="cursor">_</span>
</main>

<script>
    // Register type effect
    const typedElements = document.getElementsByClassName("typed");
    Array.from(typedElements).forEach(node => typeEffect(node as HTMLElement));

    function typeEffect(node: HTMLElement) {
        startTypeEffect(0, 10, node);
    }

    // Start type effect for every text childNode of the node
    function startTypeEffect(t: number, typeSpeed: number, node: Node): number {
        if (node.nodeType === Node.TEXT_NODE) {
            let text = node.textContent || "";
            // Skip nodes that are just whitespace between tags
            if (text.trim().length === 0) return t;
            
            node.textContent = "";
            for (let i = 0; i < text.length; i++) {
                setTimeout(textSetter(node, text.slice(0, i + 1)), t + typeSpeed * i);
            }
            return t + typeSpeed * text.length;
        } else {
            let endT = t;
            for (const child of Array.from(node.childNodes)) {
                endT = startTypeEffect(endT, typeSpeed, child);
            }
            return endT;
        }
    }

    function textSetter(textNode: Node, text: string) {
        return () => textNode.textContent = text;
    }
</script>

<style>
    main {
        position: fixed;
        top: 1em;
        left: 1em;
        right: 1em;
        padding: 1em;
        border: 0.1em solid;
        box-shadow: 0.3em 0.3em;
        background-color: var(--color-bg);
    }

    .typed {
        display: inline;
    }

    .cursor {
        animation: blink 0.7s infinite;
    }

    @keyframes blink {
        50% { opacity: 0; }
    }

    /* Desktop configuration */
    @media (orientation: landscape) {
        main {
            width: 30ex;
        }
    }
</style>
