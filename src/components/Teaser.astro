---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export type TeaserMedia = {
    // Imported image (optimized by Astro) or a public video URL string.
    src: ImageMetadata | string;
    alt: string;
    href?: string;
    pixelated?: boolean;
    // Static fallback frame shown for videos while (or instead of) they play.
    poster?: string;
};

interface Props {
    media: TeaserMedia;
}

const { media } = Astro.props;
const isVideo = typeof media.src === "string";
---

{
    isVideo ? (
        /* The poster shows instantly as a preview and remains as a fallback on
           browsers that refuse to autoplay (e.g. data-saver / low-power mode).
           The source is only loaded once the teaser scrolls into view. */
        <video
            class="teaser"
            aria-label={media.alt}
            poster={media.poster}
            loop
            muted
            playsinline
            preload="none"
            data-teaser-video
            data-src={media.src as string}
        />
    ) : media.pixelated ? (
        /* Pixel art: keep it lossless and let the browser scale it with
           nearest-neighbour so the pixels stay crisp. */
        <Image
            src={media.src as ImageMetadata}
            alt={media.alt}
            format="png"
            class="teaser pixelated"
        />
    ) : (
        <Image
            src={media.src as ImageMetadata}
            alt={media.alt}
            width={160}
            class="teaser"
        />
    )
}

<style>
    .teaser {
        display: block;
        width: 100%;
        height: auto;
        border: 1px solid currentColor;
        box-shadow: 0.15em 0.15em;
    }

    /* Keep the box square-ish before the video has any intrinsic size, so the
       poster fills the slot instead of collapsing to zero height. */
    video.teaser {
        aspect-ratio: 1 / 1;
        object-fit: cover;
        background: var(--background, #000);
    }

    .pixelated {
        image-rendering: pixelated;
    }
</style>

<script>
    // Load and play teaser videos only once they enter the viewport. This keeps
    // the initial page light (just posters) and works around browsers that
    // ignore `autoplay` until the element is actually on screen / interacted
    // with. The bundled module runs once per page regardless of how many
    // <Teaser> instances are rendered.
    function setupTeaserVideos() {
        const videos = Array.from(
            document.querySelectorAll<HTMLVideoElement>("[data-teaser-video]"),
        );
        if (videos.length === 0) return;

        const reduceMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        const load = (video: HTMLVideoElement) => {
            const src = video.dataset.src;
            if (src && !video.src) {
                video.src = src;
            }
        };

        // No IntersectionObserver (or reduced motion): just load the source so
        // the poster has a real frame behind it; don't force playback.
        if (!("IntersectionObserver" in window)) {
            videos.forEach(load);
            return;
        }

        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    const video = entry.target as HTMLVideoElement;
                    if (entry.isIntersecting) {
                        load(video);
                        if (!reduceMotion) {
                            const play = video.play();
                            if (play) play.catch(() => {});
                        }
                    } else if (!video.paused) {
                        video.pause();
                    }
                }
            },
            { rootMargin: "200px 0px" },
        );

        videos.forEach((video) => observer.observe(video));
    }

    setupTeaserVideos();
    // Astro view transitions swap the DOM without a full reload.
    document.addEventListener("astro:page-load", setupTeaserVideos);
</script>
