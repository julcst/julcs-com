---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export type TeaserMedia = {
    // Imported image, optimized by Astro. For animated teasers this is an
    // animated WebP that loops on its own and acts as the universal fallback.
    src: ImageMetadata;
    alt: string;
    href?: string;
    pixelated?: boolean;
    // Optional webm (in /public/teasers). Preferred where supported because it
    // decodes faster and looks better; falls back to the WebP otherwise.
    video?: string;
};

interface Props {
    media: TeaserMedia;
}

const { media } = Astro.props;
---

{
    media.video ? (
        /* The WebP shows instantly and stays as the fallback; the webm fades in
           on top once it actually starts playing (skipped on browsers that
           can't autoplay it, e.g. iOS). */
        <div class="teaser teaser-video-wrap">
            <Image
                src={media.src}
                alt={media.alt}
                width={320}
                loading="lazy"
                class="teaser-fallback"
            />
            <video
                class="teaser-video"
                aria-hidden="true"
                loop
                muted
                playsinline
                preload="none"
                data-teaser-video
                data-src={media.video}
            />
        </div>
    ) : media.pixelated ? (
        /* Pixel art: keep it lossless and let the browser scale it with
           nearest-neighbour so the pixels stay crisp. */
        <Image
            src={media.src}
            alt={media.alt}
            format="png"
            class="teaser pixelated"
        />
    ) : (
        <Image
            src={media.src}
            alt={media.alt}
            width={320}
            loading="lazy"
            class="teaser"
        />
    )
}

<style>
    .teaser {
        display: block;
        width: 100%;
        height: auto;
        border: 1px solid currentColor;
        box-shadow: 0.15em 0.15em;
    }

    .pixelated {
        image-rendering: pixelated;
    }

    .teaser-video-wrap {
        position: relative;
        overflow: hidden;
        line-height: 0;
    }

    .teaser-fallback {
        display: block;
        width: 100%;
        height: auto;
    }

    .teaser-video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .teaser-video.is-playing {
        opacity: 1;
    }
</style>

<script>
    // Prefer webm where it actually plays: load it lazily once in view, reveal
    // it over the WebP only after playback starts, and otherwise leave the
    // animated WebP showing. The bundled module runs once per page regardless
    // of how many <Teaser> instances are rendered.
    function setupTeaserVideos() {
        const videos = Array.from(
            document.querySelectorAll<HTMLVideoElement>("[data-teaser-video]"),
        );
        if (videos.length === 0) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            return; // leave the (lighter) WebP fallback in place
        }

        const start = (video: HTMLVideoElement) => {
            // Skip the webm download entirely if the browser can't play it.
            if (video.canPlayType && video.canPlayType("video/webm") === "") {
                return;
            }
            if (!video.src && video.dataset.src) video.src = video.dataset.src;
            const played = video.play();
            if (played) {
                played
                    .then(() => video.classList.add("is-playing"))
                    .catch(() => {}); // autoplay blocked: keep the WebP
            }
        };

        videos.forEach((video) =>
            video.addEventListener("playing", () =>
                video.classList.add("is-playing"),
            ),
        );

        if (!("IntersectionObserver" in window)) {
            videos.forEach(start);
            return;
        }

        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    const video = entry.target as HTMLVideoElement;
                    if (entry.isIntersecting) start(video);
                    else if (!video.paused) video.pause();
                }
            },
            { rootMargin: "200px 0px" },
        );

        videos.forEach((video) => observer.observe(video));
    }

    setupTeaserVideos();
    // Astro view transitions swap the DOM without a full reload.
    document.addEventListener("astro:page-load", setupTeaserVideos);
</script>
