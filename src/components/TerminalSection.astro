---
interface Props {
    id?: string;
    class?: string;
    isIntro?: boolean;
}

const { id, class: className, isIntro = false } = Astro.props;
---

<section
    id={id}
    class:list={[
        "terminal-box",
        className,
        { "intro-box": isIntro, "content-box": !isIntro },
    ]}
>
    {
        isIntro && (
            <nav class="header-nav">
                <span class="site-title">julcs.com</span>
                <div class="nav-links">
                    <a href="#cv" data-nav="cv" class="nav-btn">
                        cv
                    </a>
                    <a href="#projects" data-nav="projects" class="nav-btn">
                        projects
                    </a>
                    <a href="#tools" data-nav="tools" class="nav-btn">
                        tools
                    </a>
                </div>
            </nav>
        )
    }
    <div class="terminal-frame">
        <div class="typed">
            <slot />
        </div>
    </div>
</section>

<style>
    .terminal-box {
        padding: 1em;
        border: 0.1em solid;
        box-shadow: 0.3em 0.3em;
        background-color: var(--color-bg);
        transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
        position: relative;
        z-index: 1;
    }

    .intro-box {
        position: fixed;
        top: 1em;
        left: 1em;
        width: calc(100% - 2em);
        max-width: 30ex;
        z-index: 100;
        overflow: visible;
    }

    .header-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        margin-bottom: 0;
        line-height: 1.1;
        gap: 1rem;
        flex-wrap: wrap;
        row-gap: 0.3rem;
        opacity: 0;
        max-height: 0;
        transition:
            opacity 0.4s ease,
            max-height 0.4s ease,
            margin 0.4s ease;
        pointer-events: none;
    }

    .site-title {
        font-weight: bold;
        flex: 0 0 auto;
        white-space: nowrap;
    }

    .nav-links {
        display: flex;
        gap: 1.1em;
        flex: 1 1 auto;
        justify-content: flex-end;
        min-width: 0;
        flex-wrap: wrap;
    }

    .nav-links a {
        text-transform: lowercase;
        opacity: 0.6;
        transition: opacity 0.2s;
        white-space: nowrap;
    }

    .nav-links a.active {
        opacity: 1;
        text-decoration: underline;
    }

    /* Collapse effect when scrolled */
    :global(body.scrolled) .intro-box {
        top: 0;
        left: 0;
        width: 100%;
        max-width: 100%;
        border-top: none;
        border-left: none;
        border-right: none;
        box-shadow: none;
        padding: 0.4em 1.5em;
    }

    :global(body.scrolled) .header-nav {
        opacity: 1;
        max-height: 2em;
        margin-bottom: 0;
        pointer-events: auto;
    }

    :global(body.scrolled) .intro-box .terminal-frame {
        display: none;
    }

    /* Smoothly hide intro content when collapsed */
    :global(body.scrolled) .intro-box :global(h1),
    :global(body.scrolled) .intro-box :global(p),
    :global(body.scrolled) .intro-box :global(ul) {
        opacity: 0;
        max-height: 0;
        margin: 0;
        padding: 0;
        pointer-events: none;
        transition:
            opacity 0.3s ease,
            max-height 0.3s ease,
            margin 0.3s ease;
    }

    /* Initial state for intro content (visible) */
    .intro-box :global(h1),
    .intro-box :global(p),
    .intro-box :global(ul) {
        opacity: 1;
        max-height: 1000px;
        transition:
            opacity 0.5s ease,
            max-height 0.5s ease,
            margin 0.5s ease;
    }

    .content-box {
        margin: 2em auto;
        width: 80%;
        max-width: 1200px;
    }

    .terminal-frame {
        display: block;
    }

    .typed {
        display: block;
        white-space: normal;
        overflow-wrap: anywhere;
    }
    
    .typed [data-typing-hidden="true"] {
        display: none;
    }

    @media (max-width: 800px) {
        .content-box {
            width: calc(100% - 2em);
        }
        .nav-links {
            gap: 1em;
        }
        :global(body.scrolled) .intro-box {
            padding: 0.8em 1em;
        }
    }

    @media (max-width: 640px) {
        .header-nav {
            gap: 0.6rem;
        }
        .nav-links {
            gap: 0.7em;
            font-size: 0.92em;
        }
    }
</style>

<script>
    const globalCursor = document.getElementById("global-cursor");

    // --- SCROLL & NAV LOGIC ---
    const navLinks = document.querySelectorAll(".nav-links a");
    const sections = document.querySelectorAll(".content-box");

    window.addEventListener("scroll", () => {
        if (window.scrollY > 50) {
            document.body.classList.add("scrolled");
        } else {
            document.body.classList.remove("scrolled");
        }

        let current = "";
        sections.forEach((section) => {
            const sectionTop = (section as HTMLElement).offsetTop;
            if (window.scrollY >= sectionTop - 150) {
                current = section.getAttribute("id") || "";
            }
        });

        navLinks.forEach((link) => {
            link.classList.remove("active");
            if (link.getAttribute("data-nav") === current) {
                link.classList.add("active");
            }
        });
    });

    // --- SEQUENTIAL TYPEWRITER LOGIC ---
    const typedElements = Array.from(
        document.getElementsByClassName("typed"),
    ) as HTMLElement[];
    const typedElementIndex = new Map(
        typedElements.map((node, index) => [node, index]),
    );
    let currentTypingIndex = 0;
    let isTyping = false;
    let typingRunId = 0;
    let cancelCurrentTyping = () => {};
    const TYPING_BLOCK_SELECTOR =
        "p, li, h1, h2, h3, h4, h5, h6, .cv-entry-meta, .cv-entry-date, .cv-profile-name, .cv-profile-item, .cv-section-title, .cv-empty";
    const TYPING_CHUNK_SIZE = 4;
    const TYPING_DELAY_MS = 8;
    const HASH_LINK_SELECTOR = 'a[href^="#"]';

    // Initialize all sections as hidden/ready
    typedElements.forEach((el) => {
        el.style.opacity = "0";
    });

    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    const node = entry.target as HTMLElement;
                    node.dataset.visible = "true";
                    const index = typedElementIndex.get(node);
                    if (index !== undefined && index > currentTypingIndex) {
                        void revealThrough(index);
                    } else {
                        tryStartNext();
                    }
                }
            });
        },
        { threshold: 0.1 },
    );

    typedElements.forEach((node) => observer.observe(node));

    async function tryStartNext() {
        if (isTyping) return;
        if (currentTypingIndex >= typedElements.length) return;

        const nextNode = typedElements[currentTypingIndex];

        if (nextNode.dataset.visible === "true" || currentTypingIndex === 0) {
            isTyping = true;
            const runId = typingRunId;
            nextNode.style.opacity = "1";
            await typeNode(nextNode);
            if (runId !== typingRunId) return;
            isTyping = false;
            currentTypingIndex++;
            tryStartNext();
        }
    }

    function findTypingBlock(node: Node, rootNode: HTMLElement): HTMLElement | null {
        let current = node.parentElement;
        while (current && current !== rootNode) {
            if (current.matches(TYPING_BLOCK_SELECTOR)) return current;
            current = current.parentElement;
        }
        return null;
    }

    async function typeNode(rootNode: HTMLElement): Promise<void> {
        return new Promise(async (resolve) => {
            const textNodes: {
                node: Node;
                originalText: string;
                block: HTMLElement | null;
            }[] = [];
            const hiddenBlocks = new Set<HTMLElement>();
            let isCancelled = false;
            cancelCurrentTyping = () => {
                if (isCancelled) return;
                isCancelled = true;
                typingRunId++;
                isTyping = false;
                // Force show everything immediately
                textNodes.forEach((item) => {
                    item.node.textContent = item.originalText;
                });
                hiddenBlocks.forEach((block) => {
                    block.removeAttribute("data-typing-hidden");
                });
                resolve();
            };

            function collectAndClear(node: Node) {
                if (node.nodeType === Node.TEXT_NODE) {
                    const text = node.textContent || "";

                    if (text.trim().length === 0) {
                        node.textContent = "";
                        return;
                    }

                    const block = findTypingBlock(node, rootNode);
                    if (block) {
                        hiddenBlocks.add(block);
                    }
                    textNodes.push({ node, originalText: text, block });
                    node.textContent = "";
                } else {
                    Array.from(node.childNodes).forEach(collectAndClear);
                }
            }
            collectAndClear(rootNode);

            hiddenBlocks.forEach((block) => {
                block.setAttribute("data-typing-hidden", "true");
            });

            for (const item of textNodes) {
                if (isCancelled) break;
                if (item.block) {
                    item.block.removeAttribute("data-typing-hidden");
                }
                for (
                    let i = 0;
                    i <= item.originalText.length;
                    i += TYPING_CHUNK_SIZE
                ) {
                    if (isCancelled) break;
                    const nextIndex = Math.min(
                        item.originalText.length,
                        i + TYPING_CHUNK_SIZE,
                    );
                    item.node.textContent = item.originalText.slice(0, nextIndex);
                    if (globalCursor) {
                        item.node.after(globalCursor);
                    }
                    await new Promise((r) => setTimeout(r, TYPING_DELAY_MS));
                }
            }
            hiddenBlocks.forEach((block) => {
                block.removeAttribute("data-typing-hidden");
            });
            resolve();
        });
    }

    // --- SKIP LOGIC ---
    async function revealThrough(targetIndex: number) {
        if (targetIndex < 0) return;
        if (targetIndex < currentTypingIndex) return;

        if (isTyping) {
            cancelCurrentTyping();
            await new Promise((r) => setTimeout(r, 0));
        }

        const endIndex = Math.min(targetIndex, typedElements.length - 1);
        while (currentTypingIndex <= endIndex) {
            const node = typedElements[currentTypingIndex];
            node.style.opacity = "1";
            node.dataset.visible = "true";
            currentTypingIndex++;
        }
        tryStartNext();
    }

    const hashLinks = document.querySelectorAll(HASH_LINK_SELECTOR);
    hashLinks.forEach((link) => {
        link.addEventListener("click", async () => {
            const targetId = (link as HTMLAnchorElement)
                .getAttribute("href")
                ?.substring(1);
            if (!targetId) return;

            const targetSection = document.getElementById(targetId);
            if (!targetSection) return;
            const targetTyped = targetSection.querySelector(
                ".typed",
            ) as HTMLElement | null;
            if (!targetTyped) return;
            const targetIndex = typedElementIndex.get(targetTyped);
            if (targetIndex === undefined) return;

            await revealThrough(targetIndex);
        });
    });

    tryStartNext();
</script>
