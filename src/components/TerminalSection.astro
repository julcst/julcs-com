---
interface NavLink {
    label: string;
    href: string;
    dataNav: string;
}

interface Props {
    id?: string;
    class?: string;
    isIntro?: boolean;
    navLinks?: NavLink[];
}

const { id, class: className, isIntro = false, navLinks = [] } = Astro.props;
---

<section
    id={id}
    class:list={[
        "terminal-box",
        className,
        { "intro-box": isIntro, "content-box": !isIntro },
    ]}
>
    {
        isIntro && (
            <nav class="header-nav">
                <span class="site-title">julcs.com</span>
                <div class="nav-links">
                    {navLinks.map((link) => (
                        <a href={link.href} data-nav={link.dataNav}>
                            {link.label}
                        </a>
                    ))}
                </div>
            </nav>
        )
    }
    <div class="terminal-frame">
        <div class="typed">
            <slot />
        </div>
    </div>
</section>

<style>
    .terminal-box {
        padding: 1em;
        border: 0.1em solid;
        box-shadow: 0.3em 0.3em;
        background-color: var(--color-bg);
        transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
        position: relative;
        z-index: 1;
    }

    .content-box {
        margin: 2em auto;
        width: 80%;
        max-width: 1200px;
    }

    .typed {
        white-space: normal;
        overflow-wrap: anywhere;
    }

    /* --- Fixed intro box that collapses into a header on scroll --- */
    .intro-box {
        position: fixed;
        top: 1em;
        left: 1em;
        width: calc(100% - 2em);
        max-width: 32ex;
        z-index: 100;
        overflow: visible;
    }

    .header-nav {
        display: flex;
        align-items: center;
        gap: 1rem;
        width: 100%;
        line-height: 1.1;
        opacity: 0;
        max-height: 0;
        overflow: hidden;
        pointer-events: none;
        transition:
            opacity 0.4s ease,
            max-height 0.4s ease;
    }

    .site-title {
        flex: 0 0 auto;
        font-weight: bold;
        white-space: nowrap;
    }

    /* Single non-wrapping row; scrolls horizontally if it overflows */
    .nav-links {
        display: flex;
        flex: 1 1 auto;
        justify-content: flex-end;
        gap: 1.1em;
        overflow-x: auto;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
    }

    .nav-links::-webkit-scrollbar {
        display: none;
    }

    .nav-links a {
        white-space: nowrap;
        text-transform: lowercase;
        opacity: 0.6;
        transition: opacity 0.2s;
    }

    .nav-links a.active {
        opacity: 1;
        text-decoration: underline;
    }

    :global(body.scrolled) .intro-box {
        top: 0;
        left: 0;
        width: 100%;
        max-width: 100%;
        border-top: none;
        border-left: none;
        border-right: none;
        box-shadow: none;
        padding: 0.5em 1.5em;
    }

    :global(body.scrolled) .header-nav {
        opacity: 1;
        max-height: 2.5em;
        pointer-events: auto;
    }

    :global(body.scrolled) .intro-box .terminal-frame {
        display: none;
    }

    @media (max-width: 800px) {
        .content-box {
            width: calc(100% - 2em);
        }
        :global(body.scrolled) .intro-box {
            padding: 0.6em 1em;
        }
    }

    /* On narrow screens drop the title so the nav keeps to one tidy line */
    @media (max-width: 640px) {
        .site-title {
            display: none;
        }
        .nav-links {
            justify-content: flex-start;
            gap: 0.9em;
        }
    }
</style>

<script>
    // ----- Collapse header + highlight the active section on scroll -----
    const navLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>(".nav-links a"),
    );
    const sections = Array.from(
        document.querySelectorAll<HTMLElement>(".content-box"),
    );

    function updateScrollState() {
        document.body.classList.toggle("scrolled", window.scrollY > 50);

        const vh = window.innerHeight;
        const maxScroll = document.documentElement.scrollHeight - vh;

        // Reference line sits ~35% down the viewport. Over the final screenful
        // it slides toward the bottom of the viewport, so the short trailing
        // sections — which can never scroll up to the 35% line — still each
        // get highlighted in turn instead of being skipped.
        const bottomT =
            maxScroll > 0
                ? Math.min(1, Math.max(0, (window.scrollY - maxScroll + vh) / vh))
                : 1;
        const refLine = window.scrollY + vh * (0.35 + 0.6 * bottomT);

        let currentId = sections[0]?.id ?? "";
        for (const section of sections) {
            if (section.offsetTop <= refLine) currentId = section.id;
        }

        for (const link of navLinks) {
            link.classList.toggle("active", link.dataset.nav === currentId);
        }
    }

    window.addEventListener("scroll", updateScrollState, { passive: true });
    updateScrollState();

    // ----- "Decode" typing effect -----
    // Reveals each line left to right; only a few trailing characters scramble
    // at a time, so it reads as a typewriter rather than a chaotic flicker.
    const LINE_SELECTOR =
        ".typed :is(h1, h2, h3, h4, h5, h6, p, li, .cv-entry-date, .cv-entry-meta, .cv-entry-summary, .cv-profile-name, .cv-profile-item, .obfuscate-line)";
    const SCRAMBLE_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*+-=?";
    const SCRAMBLE_WINDOW = 3; // trailing characters that flicker before locking
    const STEP_DELAY = 18; // ms between characters (typing speed)

    const randomChar = () =>
        SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)];
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

    type Segment = { node: Text; text: string };
    type Line = {
        el: HTMLElement;
        segments: Segment[];
        typing: boolean;
        cancel: boolean;
        done: boolean;
    };

    const lines = new WeakMap<HTMLElement, Line>();

    function collectSegments(root: Node, out: Segment[]) {
        for (const node of Array.from(root.childNodes)) {
            if (node.nodeType === Node.TEXT_NODE) {
                const text = node.textContent ?? "";
                // Skip whitespace-only formatting nodes.
                if (text.trim().length === 0 && text.includes("\n")) continue;
                out.push({ node: node as Text, text });
                node.textContent = "";
            } else {
                collectSegments(node, out);
            }
        }
    }

    function setup(el: HTMLElement): Line {
        const existing = lines.get(el);
        if (existing) return existing;

        // Reserve the line's final height so revealing characters never
        // reflows surrounding content (which would jolt the scroll position).
        // The fixed intro collapses via CSS, so it must stay free to shrink.
        if (!el.closest(".intro-box")) {
            el.style.minHeight = `${el.offsetHeight}px`;
        }

        const segments: Segment[] = [];
        collectSegments(el, segments);
        el.style.opacity = "0";

        const line: Line = {
            el,
            segments,
            typing: false,
            cancel: false,
            done: false,
        };
        lines.set(el, line);
        return line;
    }

    function partial(text: string, count: number) {
        const solid = Math.max(0, count - SCRAMBLE_WINDOW);
        let out = text.slice(0, solid);
        for (let i = solid; i < count; i++) {
            // Keep whitespace intact so words wrap exactly as in the final
            // text — otherwise scrambling a space can add a line and push the
            // reserved height, resizing the box.
            out += /\s/.test(text[i]) ? text[i] : randomChar();
        }
        return out;
    }

    async function typeLine(line: Line) {
        if (line.typing || line.done) return;
        line.typing = true;
        line.cancel = false;
        line.el.style.opacity = "1";

        for (const segment of line.segments) {
            for (let count = 1; count <= segment.text.length; count++) {
                if (line.cancel) {
                    line.typing = false;
                    return;
                }
                segment.node.textContent = partial(segment.text, count);
                await sleep(STEP_DELAY);
            }
            segment.node.textContent = segment.text;
        }

        line.typing = false;
        line.done = true;
    }

    function resetLine(line: Line) {
        line.cancel = true;
        line.typing = false;
        line.done = false;
        for (const segment of line.segments) segment.node.textContent = "";
        line.el.style.opacity = "0";
    }

    const sectionLines = (section: HTMLElement) =>
        Array.from(section.querySelectorAll<HTMLElement>(LINE_SELECTOR));

    // Measure heights only once webfonts are ready so reservations are correct.
    document.fonts.ready.then(() => {
        const reduceMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;
        if (reduceMotion) return;

        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    const section = entry.target as HTMLElement;
                    for (const el of sectionLines(section)) {
                        const line = setup(el);
                        if (entry.isIntersecting) typeLine(line);
                        else resetLine(line);
                    }
                }
            },
            { threshold: 0.15, rootMargin: "0px 0px -10% 0px" },
        );

        document
            .querySelectorAll<HTMLElement>(".terminal-box")
            .forEach((section) => observer.observe(section));
    });
</script>
