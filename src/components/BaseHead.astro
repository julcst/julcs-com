---
interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: URL;
}

const {
  title,
  description,
  image = "/apple-touch-icon.png", // Fallback to icon if no specific social image
  canonicalURL: canonicalProp,
} = Astro.props;

const canonicalURL = (() => {
  if (canonicalProp) return canonicalProp;
  try {
    if (Astro.site && Astro.url) return new URL(Astro.url.pathname, Astro.site);
  } catch (e) {
    return Astro.url ?? Astro.site;
  }
  return Astro.url ?? Astro.site;
})();

const socialUrl = Astro.url ?? Astro.site;
const socialImage = (() => {
  try {
    if (Astro.site) return new URL(image, Astro.site);
    if (Astro.url) return new URL(image, Astro.url);
  } catch (e) {
    return image;
  }
  return image;
})();
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
{canonicalURL ? <link rel="canonical" href={canonicalURL} /> : null}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="Julian Stamm" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
{socialUrl ? <meta property="og:url" content={socialUrl} /> : null}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
{socialUrl ? <meta property="twitter:url" content={socialUrl} /> : null}
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={socialImage} />

<!-- Structured Data (JSON-LD) -->
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Julian Stamm",
    url: Astro.site,
    jobTitle: "Computer Science Student",
    affiliation: {
      "@type": "Organization",
      name: "University of Bonn",
    },
    description: description,
    sameAs: ["https://github.com/julcst"],
  })}
/>
