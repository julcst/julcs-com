---
import InlineText from "./InlineText.astro";
import CvDate from "./CvDate.astro";
import Teaser from "./Teaser.astro";
import type { TeaserMedia } from "./Teaser.astro";

interface Entry {
    title: string;
    date?: string;
    meta?: string;
    summary?: string;
    details?: string[];
    media?: TeaserMedia;
}

interface Props {
    title: string;
    id?: string;
    entries?: Entry[];
}

const { title, id, entries = [] } = Astro.props;
const safeEntries = Array.isArray(entries) ? entries : [];
---

{
    safeEntries.length > 0 ? (
        <section id={id} class="cv-section">
            <h2 class="cv-section-title">{title}</h2>
            <div class="cv-entries">
                {safeEntries.map((entry) => (
                    <article class="cv-entry">
                        <div class="cv-entry-main">
                            <h3 class="cv-entry-title">
                                <InlineText value={entry.title} />
                            </h3>
                            {entry.meta ? (
                                <div class="cv-entry-meta">
                                    <InlineText value={entry.meta} />
                                </div>
                            ) : null}
                            {entry.summary ? (
                                <div class="cv-entry-summary">
                                    <InlineText value={entry.summary} />
                                </div>
                            ) : null}
                            {entry.details && entry.details.length > 0 ? (
                                <ul class="cv-entry-list">
                                    {entry.details.map((detail) => (
                                        <li>
                                            <InlineText value={detail} />
                                        </li>
                                    ))}
                                </ul>
                            ) : null}
                        </div>

                        <div class="cv-entry-side">
                            <CvDate value={entry.date} />
                            {entry.media ? (
                                <div class="cv-entry-media">
                                    {entry.media.href ? (
                                        <a href={entry.media.href}>
                                            <Teaser media={entry.media} />
                                        </a>
                                    ) : (
                                        <Teaser media={entry.media} />
                                    )}
                                </div>
                            ) : null}
                        </div>
                    </article>
                ))}
            </div>
        </section>
    ) : null
}

<style>
    .cv-section {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .cv-section-title {
        font-size: 0.9rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: var(--letter-spacing-wide);
        margin: 0 0 0.4rem;
        padding-bottom: 0.25rem;
        border-bottom: 1px solid currentColor;
        opacity: 0.8;
        max-width: 100%;
        overflow-wrap: anywhere;
    }

    .cv-entries {
        display: flex;
        flex-direction: column;
        gap: 1.4rem;
    }

    .cv-entry {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 100px;
        column-gap: 1.5rem;
        margin: 0;
        padding-bottom: 0.1rem;
    }

    .cv-entry + .cv-entry {
        margin-top: 0.2rem;
    }

    .cv-entry-main {
        min-width: 0;
    }

    .cv-entry-side {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.8rem;
        padding-top: 0.15rem;
    }

    .cv-entry-title {
        font-weight: 700;
        font-size: 1.02rem;
        min-width: 0;
        overflow-wrap: anywhere;
        margin: 0;
    }

    .cv-entry-title :global(a) {
        font-weight: 700;
    }

    .cv-entry-meta {
        margin-top: 0.25rem;
        opacity: 0.78;
        font-size: var(--font-size-sm);
    }

    .cv-entry-summary {
        font-size: var(--font-size-sm);
        opacity: 0.92;
        margin-top: 0.25rem;
    }

    .cv-entry-media {
        width: 80px;
    }

    @media (max-width: 600px) {
        .cv-entry {
            grid-template-columns: 1fr;
            gap: 0.4rem;
        }

        .cv-entry-side {
            flex-direction: row-reverse;
            justify-content: space-between;
            align-items: center;
            grid-row: 1; /* Move date/media to top area on mobile */
            margin-bottom: 0.2rem;
        }

        .cv-entry-media {
            width: 60px;
        }
    }

    .cv-entry-list {
        list-style: none;
        padding: 0;
        margin: 0.4rem 0 0;
    }

    .cv-entry-list li {
        position: relative;
        margin: 0.12rem 0;
        padding-left: 1.2rem;
        line-height: 1.4;
    }

    .cv-entry-list li::before {
        content: ">";
        position: absolute;
        left: 0;
        opacity: 0.7;
    }
</style>
