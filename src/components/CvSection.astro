---
import InlineText from "./InlineText.astro";
import CvDate from "./CvDate.astro";

interface Entry {
    title: string;
    date?: string;
    meta?: string;
    summary?: string;
    details?: string[];
}

interface Props {
    title: string;
    id?: string;
    entries?: Entry[];
}

const { title, id, entries = [] } = Astro.props;
const safeEntries = Array.isArray(entries) ? entries : [];
---

{
    safeEntries.length > 0 ? (
        <section id={id} class="cv-section">
            <h2 class="cv-section-title">{title}</h2>
            <div class="cv-entries">
                {safeEntries.map((entry) => (
                    <article class="cv-entry">
                        <div class="cv-entry-head">
                            <h3 class="cv-entry-title">
                                <InlineText value={entry.title} />
                            </h3>
                            <CvDate value={entry.date} />
                        </div>
                        {entry.meta ? (
                            <div class="cv-entry-meta">
                                <InlineText value={entry.meta} />
                            </div>
                        ) : null}
                        {entry.summary ? (
                            <div class="cv-entry-summary">
                                <InlineText value={entry.summary} />
                            </div>
                        ) : null}
                        {entry.details && entry.details.length > 0 ? (
                            <ul class="cv-entry-list">
                                {entry.details.map((detail) => (
                                    <li>
                                        <InlineText value={detail} />
                                    </li>
                                ))}
                            </ul>
                        ) : null}
                    </article>
                ))}
            </div>
        </section>
    ) : null
}

<style>
    .cv-section {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .cv-section-title {
        font-size: 0.9rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: var(--letter-spacing-wide);
        margin: 0 0 0.4rem;
        padding-bottom: 0.25rem;
        border-bottom: 1px solid currentColor;
        opacity: 0.8;
        max-width: 100%;
        overflow-wrap: anywhere;
    }

    .cv-entries {
        display: flex;
        flex-direction: column;
        gap: 1.4rem;
    }

    .cv-entry {
        margin: 0;
        padding-bottom: 0.1rem;
    }

    .cv-entry + .cv-entry {
        margin-top: 0.2rem;
    }

    .cv-entry-head {
        display: grid;
        grid-template-columns: minmax(0, 1fr) max-content;
        align-items: baseline;
        column-gap: 1.2rem;
    }

    .cv-entry-title {
        font-weight: 700;
        font-size: 1.02rem;
        min-width: 0;
        overflow-wrap: anywhere;
        flex: 1 1 auto;
        margin: 0;
    }

    .cv-entry-title :global(a) {
        font-weight: 700;
    }

    .cv-entry-meta {
        margin-top: 0.25rem;
        opacity: 0.78;
        font-size: var(--font-size-sm);
    }

    .cv-entry-summary {
        margin-top: 0.25rem;
        font-size: var(--font-size-sm);
        opacity: 0.92;
    }

    .cv-entry-list {
        list-style: none;
        padding: 0;
        margin: 0.4rem 0 0;
    }

    .cv-entry-list li {
        position: relative;
        margin: 0.12rem 0;
        padding-left: 1.2rem;
        line-height: 1.4;
    }

    .cv-entry-list li::before {
        content: ">";
        position: absolute;
        left: 0;
        opacity: 0.7;
    }

    @media (max-width: 700px) {
        .cv-entry-head {
            grid-template-columns: 1fr;
            row-gap: 0.35rem;
        }
    }
</style>
