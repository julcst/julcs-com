---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import BackgroundSketch from '../components/BackgroundSketch.astro';
import TerminalSection from '../components/TerminalSection.astro';

const entry = await getEntry('pages', 'imprint');
if (!entry) throw new Error('Could not find imprint content');

const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.description}>
    <BackgroundSketch />
    <div class="imprint-wrapper">
        <TerminalSection id="imprint">
            <div class="imprint-content">
                <Content />
                <br />
                <p><a href="/">&gt; Back to home</a></p>
            </div>
        </TerminalSection>
    </div>
    <Footer />
</Layout>

<style is:global>
    .imprint-wrapper {
        padding-top: 5em;
        padding-bottom: 5em;
    }
    .imprint-content h3 {
        font-size: 1.1em;
        margin-top: 1.5em;
        margin-bottom: 0.5em;
        text-decoration: underline;
    }
    .imprint-content p {
        margin-bottom: 1em;
    }
    .imprint-content hr {
        border: none;
        border-top: 0.1em solid var(--color-front);
        margin: 2em 0;
    }
</style>
