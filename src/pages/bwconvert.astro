---
import Layout from '../layouts/Layout.astro';
---

<Layout 
    title="Black and White Converter | High-Performance WebGL" 
    description="Convert images to high-contrast black and white using hardware-accelerated WebGL2 and luminance-preserving grayscale algorithms."
>
    <style slot="head">
        body {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            overflow: hidden;
        }

        #canvas {
            border: 1px solid black;
            margin-top: 10px;
            max-width: 100%;
            max-height: 80vh;
        }

        #controls {
            margin-top: 20px;
        }
    </style>

    <h1>Black and White Converter</h1>
    <input type="file" id="upload" accept="image/*">
    <div id="controls">
        <label for="threshold">Threshold: </label>
        <input type="range" id="threshold" min="0" max="1" step="0.01" value="0.5">
        <button id="download" disabled>Download Image</button>
    </div>
    <canvas id="canvas"></canvas>

    <script>
        import { createShader, createProgram } from '../scripts/webgl';

        const vertexShaderSrc =
            `#version 300 es
            in vec2 aPosition;
            out vec2 vTexCoord;
            void main() {
                gl_Position = vec4(aPosition, 0, 1);
                vTexCoord = (aPosition + 1.0) * 0.5;
                vTexCoord.y = 1.0 - vTexCoord.y;
            }`;

        const fragmentShaderSrc =
            `#version 300 es
            precision mediump float;
            in vec2 vTexCoord;
            uniform sampler2D uImage;
            uniform float uThreshold;
            out vec4 fragColor;

            float calculateLuminance(vec3 color) {
                return dot(color.rgb, vec3(0.2126, 0.7152, 0.0722));
            }

            void main() {
                vec4 color = texture(uImage, vTexCoord);
                float luminance = calculateLuminance(color.rgb);
                float bw = luminance >= uThreshold ? 1.0 : 0.0;
                fragColor = vec4(bw, bw, bw, 1.0);
            }`;

        let gl: WebGL2RenderingContext | null, program: WebGLProgram | null, positionBuffer: WebGLBuffer | null, imageTexture: WebGLTexture | null, lThreshold: WebGLUniformLocation | null = null;

        function initWebGL() {
            const canvas = document.getElementById('canvas') as HTMLCanvasElement;
            gl = canvas.getContext('webgl2', {
                depth: false,
                stencil: false,
                antialias: false,
                preserveDrawingBuffer: true
            });
            if (!gl) {
                console.error('WebGL 2 not supported');
                return;
            }

            const vertexShader = createShader(gl, gl.VERTEX_SHADER, vertexShaderSrc);
            const fragmentShader = createShader(gl, gl.FRAGMENT_SHADER, fragmentShaderSrc);
            if (!vertexShader || !fragmentShader) return;
            program = createProgram(gl, vertexShader, fragmentShader);
            if (!program) return;

            positionBuffer = gl.createBuffer();
            gl.bindBuffer(gl.ARRAY_BUFFER, positionBuffer);
            gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([
                -1, -1,
                3, -1,
                -1, 3,
            ]), gl.STATIC_DRAW);

            gl.useProgram(program);

            const lPosition = gl.getAttribLocation(program, 'aPosition');
            gl.enableVertexAttribArray(lPosition);
            gl.bindBuffer(gl.ARRAY_BUFFER, positionBuffer);
            gl.vertexAttribPointer(lPosition, 2, gl.FLOAT, false, 0, 0);

            lThreshold = gl.getUniformLocation(program, 'uThreshold');
            gl.uniform1f(lThreshold, 0.5);

            imageTexture = gl.createTexture();
            gl.bindTexture(gl.TEXTURE_2D, imageTexture);
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);

            render();
        }

        function loadImage(src: string) {
            const img = new Image();

            img.onload = function () {
                const canvas = document.getElementById('canvas') as HTMLCanvasElement;
                canvas.width = img.width;
                canvas.height = img.height;
                if (!gl) return;
                gl.viewport(0, 0, canvas.width, canvas.height);

                gl.bindTexture(gl.TEXTURE_2D, imageTexture);
                gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, img);
                render();
                (document.getElementById('download') as HTMLButtonElement).disabled = false;
            }

            img.src = src;
        }

        function render() {
            if (!gl || !program) return;
            gl.useProgram(program);
            gl.drawArrays(gl.TRIANGLES, 0, 3);
        }

        function handleImageUpload(event: Event) {
            const target = event.target as HTMLInputElement;
            if (!target.files) return;
            const file = target.files[0];
            const reader = new FileReader();

            reader.onload = function (e) {
                if (e.target?.result) {
                    loadImage(e.target.result as string);
                }
            }

            reader.readAsDataURL(file);
        }

        function updateThreshold(event: Event) {
            const target = event.target as HTMLInputElement;
            const threshold = parseFloat(target.value);
            if (!gl || !program) return;
            gl.useProgram(program);
            gl.uniform1f(lThreshold, threshold);
            render();
        }

        function downloadImage() {
            const canvas = document.getElementById('canvas') as HTMLCanvasElement;
            const link = document.createElement('a');
            link.download = 'bw-convert.png';
            link.href = canvas.toDataURL();
            link.click();
        }

        function init() {
            initWebGL();
            document.getElementById('upload')?.addEventListener('change', handleImageUpload);
            document.getElementById('threshold')?.addEventListener('input', updateThreshold);
            document.getElementById('download')?.addEventListener('click', downloadImage);
        }

        init();
    </script>
</Layout>
