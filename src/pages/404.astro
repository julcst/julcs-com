---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BackgroundSketch from '../components/BackgroundSketch.astro';
import TerminalSection from '../components/TerminalSection.astro';

const entry = await getEntry('pages', '404');
if (!entry) throw new Error('Could not find 404 content');

const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.description}>
    <BackgroundSketch />
    <TerminalSection id="not-found" isIntro={true}>
        <Content />
    </TerminalSection>
</Layout>
