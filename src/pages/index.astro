---
import { getEntry, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import BackgroundSketch from "../components/BackgroundSketch.astro";
import TerminalSection from "../components/TerminalSection.astro";
import CvSection from "../components/CvSection.astro";
import { parse } from "yaml";
import cvYamlRaw from "../../_CV.yaml?raw";

/** UI-ready entry shown within a CV section on the homepage. */
interface CvSectionEntry {
    title: string;
    date: string;
    meta: string;
    details: string[];
}

interface ContactItem {
    label: string;
    value: string;
    href?: string;
}

interface CvEducationEntry extends Record<string, unknown> {
    institution?: string;
    area?: string;
    degree?: string;
    start_date?: string;
    end_date?: string;
    highlights?: unknown;
}

interface CvExperienceEntry extends Record<string, unknown> {
    company?: string;
    position?: string;
    location?: string;
    start_date?: string;
    end_date?: string;
    highlights?: unknown;
}

interface CvProjectEntry extends Record<string, unknown> {
    name?: string;
    start_date?: string;
    end_date?: string;
    highlights?: unknown;
}

interface CvPublicationEntry extends Record<string, unknown> {
    title?: string;
    date?: string;
    authors?: unknown;
    venue?: string;
    doi?: string;
}

interface CvSocialEntry extends Record<string, unknown> {
    network?: string;
    username?: string;
    url?: string;
}

interface CvSections {
    education?: CvEducationEntry[];
    experience?: CvExperienceEntry[];
    projects?: CvProjectEntry[];
    publications?: CvPublicationEntry[];
}

interface CvProfile {
    name?: string;
    email?: string;
    location?: string;
    website?: string;
    social_networks?: CvSocialEntry[];
    sections?: CvSections;
}

interface CvYaml {
    cv?: CvProfile;
}

interface SectionLink {
    id: string;
    label: string;
}

interface SectionLinkConfig extends SectionLink {
    show: boolean;
}

// Fetch all entries
const intro = await getEntry("pages", "index");
const tools = await getEntry("pages", "tools");

if (!intro || !tools) throw new Error("Could not find all content entries");

const { Content: IntroContent } = await render(intro);
const { Content: ToolsContent } = await render(tools);

const monthNames = [
    "Jan",
    "Feb",
    "Mar",
    "Apr",
    "May",
    "Jun",
    "Jul",
    "Aug",
    "Sept",
    "Oct",
    "Nov",
    "Dec",
];

function formatDate(value: unknown): string {
    if (!value) return "";
    if (typeof value === "string" && value.toLowerCase() === "present")
        return "present";
    if (typeof value !== "string") return String(value);

    const match = value.match(/^(\d{4})(?:-(\d{2}))?$/);
    if (!match) return value;

    const year = match[1];
    const month = match[2] ? Number.parseInt(match[2], 10) : 0;
    if (!month || month < 1 || month > 12) return year;
    return `${monthNames[month - 1]} ${year}`;
}

function formatDateRange(start: unknown, end: unknown): string {
    const startText = formatDate(start);
    const endText = formatDate(end);
    if (!startText && !endText) return "";
    if (!endText) return startText;
    if (!startText) return endText;
    return `${startText} – ${endText}`;
}

function normalizeEntryArray(
    value: unknown,
): Array<Record<string, unknown>> {
    if (!Array.isArray(value)) return [];
    return value.filter(
        (item): item is Record<string, unknown> =>
            Boolean(item) && typeof item === "object",
    );
}

function normalizeStringArray(value: unknown): string[] {
    if (!Array.isArray(value)) return [];
    return value
        .filter((item) => item !== null && item !== undefined)
        .map((item) => (typeof item === "string" ? item : String(item)));
}

function normalizeText(value: unknown): string {
    if (value === null || value === undefined) return "";
    return typeof value === "string" ? value : String(value);
}

function formatMetaLine(values: unknown[]): string {
    return values.map(normalizeText).filter(Boolean).join(" · ");
}

function buildEducationEntries(
    items: CvEducationEntry[] | undefined,
): CvSectionEntry[] {
    return normalizeEntryArray(items)
        .map((item) => {
            const title = normalizeText(item.institution);
            const date = formatDateRange(item.start_date, item.end_date);
            const meta =
                item.degree && item.area
                    ? `${item.degree} in ${item.area}`
                    : "";
            const details = normalizeStringArray(item.highlights);

            return { title, date, meta, details };
        })
        .filter((entry) => entry.title);
}

function buildExperienceEntries(
    items: CvExperienceEntry[] | undefined,
): CvSectionEntry[] {
    return normalizeEntryArray(items)
        .map((item) => {
            const title = normalizeText(item.position);
            const date = formatDateRange(item.start_date, item.end_date);
            const meta = formatMetaLine([item.location, item.company]);
            const details = normalizeStringArray(item.highlights);

            return { title, date, meta, details };
        })
        .filter((entry) => entry.title);
}

function buildProjectEntries(
    items: CvProjectEntry[] | undefined,
): CvSectionEntry[] {
    return normalizeEntryArray(items)
        .map((item) => {
            const title = normalizeText(item.name);
            const date = formatDateRange(item.start_date, item.end_date);
            const details = normalizeStringArray(item.highlights);

            return { title, date, meta: "", details };
        })
        .filter((entry) => entry.title);
}

function buildPublicationEntries(
    items: CvPublicationEntry[] | undefined,
): CvSectionEntry[] {
    return normalizeEntryArray(items)
        .map((item) => {
            const title = normalizeText(item.title);
            const date = formatDate(item.date);
            const meta = normalizeStringArray(item.authors).join(", ");
            const details = [
                normalizeText(item.venue),
                item.doi ? `[${item.doi}](https://doi.org/${item.doi})` : "",
            ].filter(Boolean);

            return { title, date, meta, details };
        })
        .filter((entry) => entry.title);
}

let yamlSections: CvSections | null = null;
let yamlProfile: CvProfile | null = null;
try {
    const cvYaml = parse(cvYamlRaw) as CvYaml;
    yamlSections = cvYaml?.cv?.sections ?? null;
    yamlProfile = cvYaml?.cv ?? null;
} catch (e) {
    yamlSections = null;
    yamlProfile = null;
}

const educationEntries = buildEducationEntries(yamlSections?.education);
const experienceEntries = buildExperienceEntries(yamlSections?.experience);
const projectEntries = buildProjectEntries(yamlSections?.projects);
const publicationEntries = buildPublicationEntries(yamlSections?.publications);

const hasCvYaml = educationEntries.length > 0 || experienceEntries.length > 0;
const hasProjectsYaml = projectEntries.length > 0;
const hasPublications = publicationEntries.length > 0;

function buildContactItems(profile: CvProfile | null): ContactItem[] {
    if (!profile) return [];
    const items: ContactItem[] = [];

    if (profile.email) {
        items.push({
            label: "Email",
            value: profile.email,
            href: `mailto:${profile.email}`,
        });
    }
    if (profile.location) {
        items.push({ label: "Location", value: profile.location });
    }
    if (profile.website) {
        items.push({
            label: "Website",
            value: profile.website,
            href: profile.website,
        });
    }

    const socials = normalizeEntryArray(profile.social_networks);
    socials.forEach((item) => {
        const network = normalizeText(item.network);
        const username = normalizeText(item.username);
        if (!network && !username) return;

        let href = normalizeText(item.url);
        if (!href && network.toLowerCase() === "github" && username) {
            href = `https://github.com/${username}`;
        }

        const value = username ? `${network}: ${username}` : network;
        items.push({ label: "Social", value, href });
    });

    return items;
}

const contactItems = buildContactItems(yamlProfile);

const today = new Date();
const dateStr = `${String(today.getMonth() + 1).padStart(2, "0")}/${today.getFullYear()}`;

const sectionLinkConfigs: SectionLinkConfig[] = [
    { id: "cv", label: "cv", show: true },
    { id: "projects", label: "projects", show: hasProjectsYaml },
    { id: "publications", label: "publications", show: hasPublications },
    { id: "tools", label: "tools", show: true },
];

const sectionLinks: SectionLink[] = sectionLinkConfigs
    .filter((section) => section.show)
    .map(({ id, label }) => ({ id, label }));
---

<Layout title={intro.data.title} description={intro.data.description}>
    <BackgroundSketch />

    <!-- Fixed Intro Box (Collapses to Header) -->
    <TerminalSection isIntro={true} navLinks={sectionLinks}>
        <IntroContent />
        <p>
            {sectionLinks.map((section, index) => (
                <>
                    <a href={`#${section.id}`} class="nav-btn">
                        &gt; {section.label}
                    </a>
                    {index < sectionLinks.length - 1 ? <br /> : null}
                </>
            ))}
        </p>
        <p>{dateStr} - julcs</p>
    </TerminalSection>

    <!-- Scrollable Content Area -->
    <div class="scroll-container">
        <TerminalSection id="cv">
            {
                hasCvYaml ? (
                    <div class="cv-body">
                        {yamlProfile?.name || contactItems.length > 0 ? (
                            <div class="cv-profile">
                                {yamlProfile?.name ? (
                                    <div class="cv-profile-name">
                                        {yamlProfile.name}
                                    </div>
                                ) : null}
                                {contactItems.length > 0 ? (
                                    <div class="cv-profile-meta">
                                        {contactItems.map((item) => (
                                            <span class="cv-profile-item">
                                                <span class="cv-profile-label">
                                                    {item.label}:
                                                </span>
                                                {item.href ? (
                                                    <a href={item.href}>
                                                        {item.value}
                                                    </a>
                                                ) : (
                                                    <span>{item.value}</span>
                                                )}
                                            </span>
                                        ))}
                                    </div>
                                ) : null}
                            </div>
                        ) : null}
                        <CvSection
                            title="Education"
                            entries={educationEntries}
                        />
                        <CvSection
                            title="Experience"
                            entries={experienceEntries}
                        />
                    </div>
                ) : (
                    <div class="cv-empty">CV data unavailable.</div>
                )
            }
        </TerminalSection>

        {
            hasProjectsYaml ? (
                <TerminalSection id="projects">
                    <div class="cv-body">
                        <CvSection title="Projects" entries={projectEntries} />
                    </div>
                </TerminalSection>
            ) : null
        }

        <TerminalSection id="tools">
            <ToolsContent />
        </TerminalSection>

        {
            hasPublications ? (
                <TerminalSection id="publications">
                    <div class="cv-body">
                        <CvSection
                            title="Publications"
                            entries={publicationEntries}
                        />
                    </div>
                </TerminalSection>
            ) : null
        }
    </div>

    <Footer />
</Layout>

<style>
    .scroll-container {
        padding-top: 100vh; /* Show only intro initially */
        padding-bottom: 10vh;
        display: flex;
        flex-direction: column;
        gap: 2rem; /* Tighter spacing between sections */
    }

    .cv-body {
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
        white-space: normal;
    }

    .cv-profile {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .cv-profile-name {
        font-size: 1.2rem;
        font-weight: 700;
    }

    .cv-profile-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem 1.6rem;
        font-size: var(--font-size-sm);
    }

    .cv-profile-item {
        display: inline-flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.2rem;
    }

    .cv-profile-label {
        font-size: var(--font-size-xs);
        letter-spacing: var(--letter-spacing-wide);
        text-transform: uppercase;
        opacity: 0.55;
    }

    .cv-empty {
        opacity: 0.7;
        font-size: var(--font-size-sm);
    }

    .cv-body * {
        white-space: normal;
    }

    /* Smooth scroll behavior */
    :global(html) {
        scroll-behavior: smooth;
    }
</style>
