---
import { getEntry, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import BackgroundSketch from "../components/BackgroundSketch.astro";
import TerminalSection from "../components/TerminalSection.astro";
import CvSection from "../components/CvSection.astro";
import { parse } from "yaml";
import cvYamlRaw from "../../_CV.yaml?raw";

// Fetch all entries
const intro = await getEntry("pages", "index");
const tools = await getEntry("pages", "tools");

if (!intro || !tools) throw new Error("Could not find all content entries");

const { Content: IntroContent } = await render(intro);
const { Content: ToolsContent } = await render(tools);

type EntryRecord = Record<string, any>;

type SectionEntry = {
    title: string;
    date?: string;
    meta?: string;
    summary?: string;
    details?: string[];
};

type NavLink = {
    label: string;
    href: string;
    dataNav: string;
};

type GeneratedSection = {
    id: string;
    title: string;
    entries: SectionEntry[];
};

const monthNames = [
    "Jan",
    "Feb",
    "Mar",
    "Apr",
    "May",
    "Jun",
    "Jul",
    "Aug",
    "Sept",
    "Oct",
    "Nov",
    "Dec",
];

function formatDate(value: any): string {
    if (!value) return "";
    if (typeof value === "string" && value.toLowerCase() === "present")
        return "present";
    if (typeof value !== "string") return String(value);

    const match = value.match(/^(\d{4})(?:-(\d{2}))?$/);
    if (!match) return value;

    const year = match[1];
    const month = match[2] ? Number.parseInt(match[2], 10) : 0;
    if (!month || month < 1 || month > 12) return year;
    return `${monthNames[month - 1]} ${year}`;
}

function formatDateRange(start: any, end: any): string {
    const startText = formatDate(start);
    const endText = formatDate(end);
    if (!startText && !endText) return "";
    if (!endText) return startText;
    if (!startText) return endText;
    return `${startText} – ${endText}`;
}

function normalizeEntryArray(value: any): EntryRecord[] {
    if (!Array.isArray(value)) return [];
    return value.filter((item) => item && typeof item === "object");
}

function normalizeStringArray(value: any): string[] {
    if (!Array.isArray(value)) return [];
    return value
        .filter((item) => item !== null && item !== undefined)
        .map((item) => (typeof item === "string" ? item : String(item)));
}

function normalizeTextList(value: any): string[] {
    if (Array.isArray(value)) return normalizeStringArray(value);
    if (typeof value === "string") return value ? [value] : [];
    return [];
}

function normalizeText(value: any): string {
    if (value === null || value === undefined) return "";
    return typeof value === "string" ? value : String(value);
}

function formatMetaLine(values: any[]): string {
    return values.map(normalizeText).filter(Boolean).join(" · ");
}

function getFirstText(
    item: EntryRecord | null | undefined,
    keys: string[],
): string {
    for (const key of keys) {
        const value = normalizeText(item?.[key]);
        if (value) return value;
    }
    return "";
}

function humanizeSectionKey(key: string): string {
    return normalizeText(key)
        .replace(/[_-]+/g, " ")
        .replace(/\b\w/g, (character) => character.toUpperCase());
}

function buildEntrySummary(item: EntryRecord | null | undefined): string {
    return getFirstText(item, ["summary", "description", "abstract"]);
}

function buildEntryDetails(item: EntryRecord | null | undefined): string[] {
    return normalizeTextList(
        item?.highlights ?? item?.details ?? item?.bullets,
    );
}

function buildEducationEntries(items: any): SectionEntry[] {
    return normalizeEntryArray(items)
        .map((item) => {
            const title = normalizeText(item.institution);
            const date = formatDateRange(item.start_date, item.end_date);
            const meta =
                item.degree && item.area
                    ? `${item.degree} in ${item.area}`
                    : normalizeText(item.degree);
            const summary = buildEntrySummary(item);
            const details = buildEntryDetails(item);

            return { title, date, meta, summary, details };
        })
        .filter((entry) => entry.title);
}

function buildExperienceEntries(items: any): SectionEntry[] {
    return normalizeEntryArray(items)
        .map((item) => {
            const title = normalizeText(item.position);
            const date = formatDateRange(item.start_date, item.end_date);
            const meta = formatMetaLine([item.location, item.company]);
            const summary = buildEntrySummary(item);
            const details = buildEntryDetails(item);

            return { title, date, meta, summary, details };
        })
        .filter((entry) => entry.title);
}

function buildProjectEntries(items: any): SectionEntry[] {
    return normalizeEntryArray(items)
        .map((item) => {
            const title = normalizeText(item.name);
            const date = formatDateRange(item.start_date, item.end_date);
            const summary = buildEntrySummary(item);
            const details = buildEntryDetails(item);

            return { title, date, meta: "", summary, details };
        })
        .filter((entry) => entry.title);
}

function buildPublicationEntries(items: any): SectionEntry[] {
    return normalizeEntryArray(items)
        .map((item) => {
            const title = normalizeText(item.title);
            const date = formatDate(item.date);
            const meta = normalizeStringArray(item.authors).join(", ");
            const summary = buildEntrySummary(item);
            const details = [
                normalizeText(item.type),
                normalizeText(item.journal ?? item.venue),
                item.url
                    ? `[${normalizeText(item.url)}](${normalizeText(item.url)})`
                    : "",
                item.doi ? `[${item.doi}](https://doi.org/${item.doi})` : "",
            ].filter(Boolean);

            return { title, date, meta, summary, details };
        })
        .filter((entry) => entry.title);
}

function buildSkillEntries(items: any): SectionEntry[] {
    return normalizeEntryArray(items)
        .map((item) => {
            const title = getFirstText(item, ["label", "name", "title"]);
            const meta = normalizeTextList(item.details).join(", ");

            return { title, meta, summary: "", details: [] };
        })
        .filter((entry) => entry.title);
}

function buildGenericEntries(sectionKey: string, items: any): SectionEntry[] {
    return normalizeEntryArray(items)
        .map((item) => {
            const title = getFirstText(item, [
                "title",
                "name",
                "label",
                "institution",
                "position",
            ]);
            const date = formatDateRange(
                item.start_date,
                item.end_date ?? item.date,
            );
            const meta = formatMetaLine([item.company, item.location]);
            const summary = buildEntrySummary(item);
            const details = buildEntryDetails(item);

            return { title, date, meta, summary, details };
        })
        .filter((entry) => entry.title);
}

function buildSectionEntries(sectionKey: string, items: any): SectionEntry[] {
    if (sectionKey === "education") return buildEducationEntries(items);
    if (sectionKey === "experience") return buildExperienceEntries(items);
    if (sectionKey === "projects" || sectionKey === "others") {
        return buildProjectEntries(items);
    }
    if (sectionKey === "publications") return buildPublicationEntries(items);
    if (sectionKey === "skills") return buildSkillEntries(items);

    return buildGenericEntries(sectionKey, items);
}

let yamlSections = null;
let yamlProfile = null;
try {
    const cvYaml = parse(cvYamlRaw);
    yamlSections = cvYaml?.cv?.sections ?? null;
    yamlProfile = cvYaml?.cv ?? null;
} catch (e) {
    yamlSections = null;
    yamlProfile = null;
}

const generatedSections = Object.entries(yamlSections ?? {})
    .map(([sectionKey, sectionValue]): GeneratedSection | null => {
        const entries = buildSectionEntries(sectionKey, sectionValue);
        if (entries.length === 0) return null;

        return {
            id: sectionKey,
            title: humanizeSectionKey(sectionKey),
            entries,
        };
    })
    .filter((section): section is GeneratedSection => section !== null);

function buildContactItems(
    profile: EntryRecord | null | undefined,
): Array<{ label: string; value: string; href?: string }> {
    if (!profile) return [];
    const items = [];

    if (profile.email) {
        items.push({
            label: "Email",
            value: profile.email,
            href: `mailto:${profile.email}`,
        });
    }
    if (profile.location) {
        items.push({ label: "Location", value: profile.location });
    }
    if (profile.website) {
        items.push({
            label: "Website",
            value: profile.website,
            href: profile.website,
        });
    }

    const socials = normalizeEntryArray(profile.social_networks);
    socials.forEach((item) => {
        const network = normalizeText(item.network);
        const username = normalizeText(item.username);
        if (!network && !username) return;

        let href = normalizeText(item.url);
        if (!href && network.toLowerCase() === "github" && username) {
            href = `https://github.com/${username}`;
        }

        const value = username ? `${network}: ${username}` : network;
        items.push({ label: "Social", value, href });
    });

    return items;
}

const contactItems = buildContactItems(yamlProfile);

const hasProfile = Boolean(yamlProfile?.name || contactItems.length > 0);
const hasCvYaml = hasProfile || generatedSections.length > 0;

const navLinks: NavLink[] = [
    { label: "cv", href: "#cv", dataNav: "cv" },
    ...generatedSections.map((section) => ({
        label: section.title.toLowerCase(),
        href: `#${section.id}`,
        dataNav: section.id,
    })),
    { label: "tools", href: "#tools", dataNav: "tools" },
];

const today = new Date();
const dateStr = `${String(today.getMonth() + 1).padStart(2, "0")}/${today.getFullYear()}`;
---

<Layout title={intro.data.title} description={intro.data.description}>
    <BackgroundSketch />

    <!-- Fixed Intro Box (Collapses to Header) -->
    <TerminalSection isIntro={true} navLinks={navLinks}>
        <IntroContent />
        <p>
            {
                navLinks.map((link) => (
                    <>
                        <a href={link.href} data-nav={link.dataNav}>
                            &gt; {link.label}
                        </a>
                        <br />
                    </>
                ))
            }
        </p>
        <p>{dateStr} - julcs</p>
    </TerminalSection>

    <!-- Scrollable Content Area -->
    <div class="scroll-container">
        <TerminalSection id="cv" class="content-box">
            {
                hasProfile ? (
                    <div class="cv-profile">
                        {yamlProfile?.name ? (
                            <div class="cv-profile-name">
                                {yamlProfile.name}
                            </div>
                        ) : null}
                        {contactItems.length > 0 ? (
                            <div class="cv-profile-meta">
                                {contactItems.map((item) => (
                                    <span class="cv-profile-item">
                                        <span class="cv-profile-label">
                                            {item.label}:
                                        </span>
                                        {item.href ? (
                                            <a href={item.href}>{item.value}</a>
                                        ) : (
                                            <span>{item.value}</span>
                                        )}
                                    </span>
                                ))}
                            </div>
                        ) : null}
                    </div>
                ) : (
                    <div class="cv-empty">CV data unavailable.</div>
                )
            }
        </TerminalSection>

        {
            generatedSections.map((section) => (
                <TerminalSection id={section.id} class="content-box">
                    <CvSection
                        title={section.title}
                        entries={section.entries}
                    />
                </TerminalSection>
            ))
        }

        <TerminalSection id="tools" class="content-box">
            <ToolsContent />
        </TerminalSection>
    </div>

    <Footer />
</Layout>

<style>
    .scroll-container {
        padding-top: 100vh; /* Show only intro initially */
        padding-bottom: 10vh;
        display: flex;
        flex-direction: column;
        gap: 2rem; /* Tighter spacing between sections */
    }

    .cv-body {
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
        white-space: normal;
    }

    .cv-profile {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .cv-profile-name {
        font-size: 1.2rem;
        font-weight: 700;
    }

    .cv-profile-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem 1.6rem;
        font-size: var(--font-size-sm);
    }

    .cv-profile-item {
        display: inline-flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.2rem;
    }

    .cv-profile-label {
        font-size: var(--font-size-xs);
        letter-spacing: var(--letter-spacing-wide);
        text-transform: uppercase;
        opacity: 0.55;
    }

    .cv-empty {
        opacity: 0.7;
        font-size: var(--font-size-sm);
    }

    .cv-body * {
        white-space: normal;
    }

    /* Smooth scroll behavior */
    :global(html) {
        scroll-behavior: smooth;
    }
</style>
