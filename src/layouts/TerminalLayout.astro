---
import Layout from './Layout.astro';
import Footer from '../components/Footer.astro';
import BackgroundSketch from '../components/BackgroundSketch.astro';
import TerminalContainer from '../components/TerminalContainer.astro';

interface Props {
	title: string;
	description: string;
	showFooter?: boolean;
}

const { title, description, showFooter = false } = Astro.props;
---

<Layout title={title} description={description}>
    <BackgroundSketch />
    <TerminalContainer>
        <slot />
    </TerminalContainer>
    {showFooter && <Footer />}
</Layout>
